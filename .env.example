# Copy to .env and fill in. .env is git-ignored; never commit real credentials.

APP_NAME=icd-rag-service
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000

LOG_LEVEL=INFO
# json (default, for log shipping) or console (human-readable)
LOG_FORMAT=json

# Local PostgreSQL installed on Windows. The role needs CREATEDB (integration tests create and
# drop a scratch database); the default `postgres` superuser works for local development.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=icd_rag
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me

# Optional: a full URL overrides the DATABASE_* parts above (driver is forced to asyncpg).
# DATABASE_URL=postgresql://user:password@host:5432/icd_rag

# --- Embeddings (docs/retrieval.md) ---------------------------------------------------------
# sentence_transformers (local semantic model, default) | openai (OpenAI-compatible API) |
# hashing (deterministic lexical hashing; tests/offline only) | none (semantic disabled)
EMBEDDING_PROVIDER=sentence_transformers
# Any sentence-transformers compatible model; downloaded once into HF_HOME (Docker: volume
# hf-cache). Swap for a medical-domain model by configuration, then run `cli index`.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional: expected dimension. The model's real dimension is always used and must match it.
# EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true
# cosine | l2 | inner_product (index operator class and query operator always match)
EMBEDDING_DISTANCE=cosine
# Prefix for queries only (asymmetric models, e.g. "query: " for E5). Empty for BGE v1.5.
EMBEDDING_QUERY_PREFIX=
# Raw similarity at/below which the semantic score is 0. Unset = provider default
# (0.6 for sentence-transformers, calibrated for bge-small; re-measure for other models).
# EMBEDDING_SIMILARITY_FLOOR=0.6
EMBEDDING_QUERY_CACHE_SIZE=256
# optional: degrade to exact/lexical/fuzzy when semantic retrieval is unavailable;
# required: fail such requests with 503.
SEMANTIC_RETRIEVAL_MODE=optional
# Remote providers only. Datasets must allow remote processing in their licence metadata.
# EMBEDDING_API_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=

# --- Retrieval / suggestion (docs/retrieval.md, docs/reranking.md) ---------------------------
RETRIEVAL_WEIGHT_EXACT=0.30
RETRIEVAL_WEIGHT_LEXICAL=0.25
RETRIEVAL_WEIGHT_FUZZY=0.20
RETRIEVAL_WEIGHT_SEMANTIC=0.15
RETRIEVAL_WEIGHT_HIERARCHY=0.05
RETRIEVAL_WEIGHT_INDEX_TERM=0.05
RETRIEVAL_CANDIDATES_PER_METHOD=30
RETRIEVAL_FUZZY_THRESHOLD=0.3
MAX_TOP_K=20
CLINICAL_NOTE_MAX_CHARS=20000
SUGGEST_UNCERTAIN_CONCEPTS=true
# Minimum retrieval evidence for a suggestion (weaker matches are reported, not guessed).
SUGGESTION_MIN_EVIDENCE=0.15
SUGGESTION_MIN_LEXICAL_EVIDENCE=0.4

# --- Security (docs/security.md) ---------------------------------------------------------------
# Admin endpoints are disabled (404) unless a token is set. Use a long random value.
# ADMIN_API_TOKEN=
# Never enable in production (startup fails if APP_ENV=production and this is true).
LOG_CLINICAL_TEXT=false
